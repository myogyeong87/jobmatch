rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 라운드별 순위표: 학생 기기에서 로그인 없이 기록을 남긴다.
    // 생성만 허용하고, 이후 수정/삭제는 막아 학급 환경에서의 임의 변조를 최소화한다.
    match /roundScores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['round', 'name', 'timeMs', 'createdAt'])
        && request.resource.data.round is int
        && request.resource.data.round >= 1
        && request.resource.data.round <= 9
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.timeMs is number
        && request.resource.data.timeMs > 0
        && request.resource.data.timeMs <= 3600000;
      allow update, delete: if false;
    }

    // 동명이인 처리를 위한 이름별 접속 순번 카운터.
    match /nameCounters/{baseName} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
